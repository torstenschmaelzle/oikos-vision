# Copy to /etc/oikos-api.env (production) or export in your shell for local runs.
# Never commit real values.

# Database (PostgreSQL/PostGIS on AWS RDS). Credentials are read from AWS Secrets Manager.
AWS_REGION=eu-north-1
OIKOS_DB_SECRET_ID=your-secrets-manager-secret-id
PGHOST=your-db-host
PGPORT=5432
PGDATABASE=postgres
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/pki/rds/global-bundle.pem
PG_STATEMENT_TIMEOUT_MS=0

# API
CORS_ALLOW_ORIGINS=http://localhost:8080
JWT_SECRET=generate-a-long-random-string
FRONTEND_BASE_URL=http://localhost:8080

# Transactional email (Resend) for user invitations
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Oikos <noreply@example.com>
INVITATION_TOKEN_EXPIRE_DAYS=7

# Shared key for the crawler endpoints (/crawler/*)
CRAWLER_API_KEY=
